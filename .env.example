# M1 does not use a model or require an API key.
EPIPHANY_DATABASE_URL=sqlite+aiosqlite:///./data/epiphany.db
EPIPHANY_CREATE_SCHEMA_ON_START=false
EPIPHANY_LOG_LEVEL=INFO
EPIPHANY_WORKER_ENABLED=true
EPIPHANY_WORKER_POLL_INTERVAL_SECONDS=0.25
EPIPHANY_WORKER_MAX_CONCURRENCY=2
EPIPHANY_WORKER_LEASE_SECONDS=30
EPIPHANY_TASK_TIMEOUT_SECONDS=30
EPIPHANY_TASK_MAX_ATTEMPTS=2
EPIPHANY_MODEL_MAX_CALLS_PER_RUN=6
EPIPHANY_MODEL_PROVIDER=fake

# M2.3b: change MODEL_PROVIDER to deepseek only when a live call is intended.
# Keep the real key only in backend/.env, never in Git.
EPIPHANY_DEEPSEEK_API_KEY=
EPIPHANY_DEEPSEEK_BASE_URL=https://api.deepseek.com
EPIPHANY_DEEPSEEK_MODEL=deepseek-v4-flash
# The API response does not reveal the account's billing currency.
# Keep USD for backward compatibility; use CNY when the DeepSeek account bills in CNY.
EPIPHANY_DEEPSEEK_BILLING_CURRENCY=USD
EPIPHANY_DEEPSEEK_MAX_TOKENS=2000
# A full candidate script needs a larger output allowance than research JSON.
EPIPHANY_DEEPSEEK_EDITOR_MAX_TOKENS=20000
# Structured self-review needs evidence but should remain much shorter than the draft.
EPIPHANY_DEEPSEEK_QUALITY_REVIEW_MAX_TOKENS=6000
EPIPHANY_DEEPSEEK_MAX_SOURCE_CHARS=24000
# A validated Timeline + Theme bundle can be larger than one raw source payload.
EPIPHANY_DEEPSEEK_MAX_INTERVIEW_BUNDLE_CHARS=24000
# Editor input combines the scaffold with initial and supplemental source segments.
EPIPHANY_DEEPSEEK_MAX_EDITOR_BUNDLE_CHARS=48000
# Reviewer input combines the draft, Brief, and cited evidence; deterministic
# metrics stay separate so the model cannot anchor on the rule score.
EPIPHANY_DEEPSEEK_MAX_QUALITY_BUNDLE_CHARS=80000

MAX_PARALLEL_SUBAGENTS=2
MAX_SUBAGENT_DEPTH=1

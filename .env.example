# M1 does not use a model or require an API key.
EPIPHANY_DATABASE_URL=sqlite+aiosqlite:///./data/epiphany.db
EPIPHANY_CREATE_SCHEMA_ON_START=false
EPIPHANY_LOG_LEVEL=INFO
EPIPHANY_WORKER_ENABLED=true
EPIPHANY_WORKER_POLL_INTERVAL_SECONDS=0.25
EPIPHANY_WORKER_MAX_CONCURRENCY=2
EPIPHANY_WORKER_LEASE_SECONDS=30
EPIPHANY_TASK_TIMEOUT_SECONDS=30
EPIPHANY_TASK_MAX_ATTEMPTS=2

# Reserved for M2. API usage is billed separately from a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE_RESPONSES=false

MAX_PARALLEL_SUBAGENTS=2
MAX_SUBAGENT_DEPTH=1
MAX_MODEL_CALLS_PER_RUN=6
